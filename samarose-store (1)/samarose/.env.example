# Copy to .env (never commit .env). On a host, set these as environment variables instead.
NODE_ENV=production
PORT=3000
# Public address of the site, HTTPS, no trailing slash. PayFast uses it to send customers back and to notify us.
SITE_URL=samarose.co.za

# Where the database and uploaded photos live. On a host, point this at a persistent disk/volume.
DATA_DIR=./data
# UPLOAD_DIR=./data/uploads

# First owner login (created once, only when no admin exists). Remove ADMIN_PASSWORD afterwards.
ADMIN_EMAIL=
ADMIN_PASSWORD=


# Email (optional but recommended): order confirmations to customers, new-order alerts to the owner.
OWNER_EMAIL="samarose@samarose.ac.za"
SMTP_HOST="mail.samarose.ac.za"
SMTP_PORT=587
SMTP_USER="samarose@samarose.ac.za"
SMTP_PASS=
MAIL_FROM="SamaRose <"samarose@samarose.ac.za">"
